{id:"lens_owen_1",parent:"오웬",name:"파라다이소 기사 :: 오웬",rarity:3},{id:"lens_owen_2",parent:"오웬",name:"찰스 브리게이드 대원 :: 오웬",rarity:3},{id:"lens_owen_3",parent:"오웬",name:"듀마 엔진 용병 :: 오웬",rarity:3}
