{id:"lens_dorothy_1",parent:"도로시",name:"킷츠가와 사병 :: 도로시",rarity:3},{id:"lens_dorothy_2",parent:"도로시",name:"타츠우미 요코메 :: 도로시",rarity:3},{id:"lens_dorothy_3",parent:"도로시",name:"에테르사 시험체 :: 도로시",rarity:3},
{id:"lens_baekyeon_1",parent:"백연",name:"조석 사무소 대원 :: 백연",rarity:3},{id:"lens_baekyeon_2",parent:"백연",name:"왕실 운검 :: 백연",rarity:3},{id:"lens_baekyeon_3",parent:"백연",name:"킷츠가와 객원검사 :: 백연",rarity:3},
{id:"lens_kurose_1",parent:"쿠로세",name:"아스트론 학파 연구지구 연구원 :: 쿠로세",rarity:3},{id:"lens_kurose_2",parent:"쿠로세",name:"킷츠가와 당주 :: 쿠로세",rarity:3},{id:"lens_kurose_3",parent:"쿠로세",name:"천진개발공사 경비원 :: 쿠로세",rarity:3},
{id:"lens_jacqueline_1",parent:"재클린",name:"에테르사 통상 요원 :: 재클린",rarity:3},{id:"lens_jacqueline_2",parent:"재클린",name:"터미널15 검시관 :: 재클린",rarity:3},{id:"lens_jacqueline_3",parent:"재클린",name:"자오선 현장 연구원 :: 재클린",rarity:3},
{id:"lens_yuna_1",parent:"유나",name:"조석 사무소 대표 :: 유나",rarity:3},{id:"lens_yuna_2",parent:"유나",name:"자오선 조사관 :: 유나",rarity:3},{id:"lens_yuna_3",parent:"유나",name:"공작나방 연락책 :: 유나",rarity:3},
