<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>N.O.D. 헤드헌팅 광학 단말</title>
<style>
:root{
  --bg:#090907;
  --panel:#12120f;
  --panel2:#191813;
  --line:#3b392d;
  --line2:#575342;
  --paper:#d7d0b9;
  --muted:#8d8878;
  --amber:#d69b43;
  --amber2:#ffbd61;
  --red:#a84d3c;
  --infra:#df6658;
  --ultra:#c799d7;
  --lumen:#d9dce0;
  --lens:#8fc9d8;
  --green:#8fa47d;
  --shadow:rgba(0,0,0,.55);
  --safe-top:env(safe-area-inset-top,0px);
  --safe-right:env(safe-area-inset-right,0px);
  --safe-bottom:env(safe-area-inset-bottom,0px);
  --safe-left:env(safe-area-inset-left,0px);
}
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;background:var(--bg);color:var(--paper);font-family:"SFMono-Regular","Pretendard","Noto Sans KR",monospace;overflow:hidden}
button,input,select{font:inherit}
button{color:inherit}
body::before{content:"";position:fixed;inset:0;pointer-events:none;z-index:999;background:
  repeating-linear-gradient(0deg,rgba(255,255,255,.018) 0 1px,transparent 1px 3px),
  radial-gradient(circle at center,transparent 50%,rgba(0,0,0,.35) 100%);mix-blend-mode:screen;opacity:.55}
body::after{content:"";position:fixed;inset:0;pointer-events:none;z-index:998;box-shadow:inset 0 0 80px rgba(0,0,0,.7)}
.app{height:100%;display:grid;grid-template-rows:52px 1fr;padding:var(--safe-top) var(--safe-right) var(--safe-bottom) var(--safe-left)}
.topbar{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;border-bottom:1px solid var(--line);background:linear-gradient(#11110e,#0c0c0a);padding:0 14px;gap:12px;box-shadow:0 6px 18px rgba(0,0,0,.28);z-index:5}
.brand{min-width:0;display:flex;align-items:center;gap:12px}
.brandMark{width:30px;height:30px;border:1px solid var(--amber);border-radius:50%;display:grid;place-items:center;position:relative;color:var(--amber);box-shadow:inset 0 0 0 4px #111,0 0 14px rgba(214,155,67,.12)}
.brandMark::before,.brandMark::after{content:"";position:absolute;background:var(--amber);opacity:.6}
.brandMark::before{width:1px;height:36px}.brandMark::after{height:1px;width:36px}
.brandTitle{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:13px;letter-spacing:.08em}
.brandSub{font-size:9px;color:var(--muted);letter-spacing:.15em;margin-top:2px}
.resources{display:flex;gap:7px;align-items:center}
.meter{border:1px solid var(--line);background:#10100d;border-radius:2px;padding:5px 8px;min-width:88px}
.meterLabel{font-size:8px;color:var(--muted);letter-spacing:.14em}.meterValue{font-size:12px;color:var(--amber2);margin-top:1px}
.shell{min-height:0;display:grid;grid-template-columns:76px 1fr;background:linear-gradient(135deg,#0c0c09,#11100d)}
.nav{border-right:1px solid var(--line);background:#0d0d0a;padding:8px 6px;display:flex;flex-direction:column;gap:6px;overflow:auto}
.navBtn{appearance:none;border:1px solid transparent;background:transparent;padding:8px 3px;border-radius:3px;cursor:pointer;text-align:center;color:var(--muted);min-height:54px}
.navBtn:hover{background:#161510;color:var(--paper);border-color:#2f2d24}.navBtn.active{background:#1d1a12;color:var(--amber2);border-color:#57482f;box-shadow:inset 3px 0 0 var(--amber)}
.navIcon{display:block;font-size:19px;line-height:1;margin-bottom:5px}.navText{font-size:9px;line-height:1.2;letter-spacing:.04em}
.main{min-width:0;min-height:0;position:relative;overflow:hidden}
.page{position:absolute;inset:0;padding:10px;overflow:auto;opacity:0;transform:translateX(12px);pointer-events:none;transition:.18s ease}
.page.active{opacity:1;transform:none;pointer-events:auto}
.panel{border:1px solid var(--line);background:linear-gradient(180deg,rgba(27,26,21,.96),rgba(16,16,13,.96));box-shadow:0 12px 30px var(--shadow);border-radius:4px}
.panelHeader{height:34px;display:flex;align-items:center;justify-content:space-between;padding:0 10px;border-bottom:1px solid var(--line);background:linear-gradient(#1a1915,#13130f)}
.panelTitle{font-size:10px;letter-spacing:.15em;color:#b8b09a}.panelMeta{font-size:8px;color:#706d61}
/* GACHA */
.gachaGrid{height:100%;display:grid;grid-template-columns:minmax(150px,24%) minmax(300px,1fr) minmax(220px,31%);gap:8px;min-height:0}
.bannerRack,.cameraDeck,.controlDeck{min-height:0;overflow:hidden}
.bannerList{padding:8px;height:calc(100% - 34px);overflow:auto;display:flex;flex-direction:column;gap:7px}
.bannerCard{appearance:none;width:100%;color:inherit;text-align:left;font:inherit;position:relative;border:1px solid #343128;background:#12120e;padding:9px 8px 9px 13px;cursor:pointer;min-height:72px;overflow:hidden}
.bannerCard::before{content:"";position:absolute;left:4px;top:7px;bottom:7px;width:3px;background:repeating-linear-gradient(to bottom,#625d4d 0 5px,transparent 5px 10px)}
.bannerCard:hover{border-color:#615a46}.bannerCard.active{border-color:var(--amber);background:linear-gradient(100deg,#2a2215,#171611);box-shadow:inset 0 0 22px rgba(214,155,67,.07)}
.bannerType{font-size:8px;color:var(--amber);letter-spacing:.11em;margin-bottom:4px}.bannerName{font-size:11px;line-height:1.3}.bannerMini{font-size:8px;color:var(--muted);margin-top:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cameraDeck{display:grid;grid-template-rows:1fr auto;background:#0b0b09}
.viewfinder{position:relative;min-height:0;display:grid;place-items:center;overflow:hidden;background:
  radial-gradient(circle at 50% 45%,rgba(90,84,62,.18),transparent 28%),
  linear-gradient(160deg,#12110d,#090907 65%)}
.viewfinder::before{content:"";position:absolute;inset:11px;border:1px solid rgba(214,155,67,.35);pointer-events:none}
.viewfinder::after{content:"";position:absolute;inset:24px;border:1px solid rgba(215,208,185,.08);pointer-events:none}
.corner{position:absolute;width:26px;height:26px;border-color:var(--paper);opacity:.35}.c1{left:20px;top:20px;border-left:1px solid;border-top:1px solid}.c2{right:20px;top:20px;border-right:1px solid;border-top:1px solid}.c3{left:20px;bottom:20px;border-left:1px solid;border-bottom:1px solid}.c4{right:20px;bottom:20px;border-right:1px solid;border-bottom:1px solid}
.focusCross{position:absolute;left:50%;top:50%;width:54px;height:34px;transform:translate(-50%,-50%);border:1px solid rgba(214,155,67,.3)}
.focusCross::before,.focusCross::after{content:"";position:absolute;background:rgba(214,155,67,.35)}.focusCross::before{width:18px;height:1px;left:17px;top:16px}.focusCross::after{width:1px;height:18px;left:26px;top:8px}
.hero{width:min(84%,640px);text-align:center;padding:22px;position:relative;z-index:2}
.heroOverline{font-size:9px;color:var(--amber);letter-spacing:.18em}.heroTitle{font-family:Georgia,"Noto Serif KR",serif;font-size:clamp(18px,3.2vw,34px);line-height:1.15;margin:9px 0 8px;color:#e8e0c9;text-shadow:0 2px 0 #000}.heroDesc{font-size:10px;line-height:1.6;color:var(--muted);max-width:560px;margin:0 auto}.pickupPlate{display:flex;flex-wrap:wrap;justify-content:center;gap:7px;margin-top:16px}.pickupChip{border:1px solid #4b4739;background:#12110e;padding:6px 8px;font-size:9px}.pickupChip.lens{border-color:#36545e;color:var(--lens)}
.exposureBar{position:absolute;left:20px;right:20px;bottom:10px;display:flex;justify-content:space-between;color:#777266;font-size:8px;letter-spacing:.08em}.exposureBar strong{color:var(--amber2);font-weight:500}
.shutterStrip{border-top:1px solid var(--line);background:#11110e;padding:7px 10px;display:grid;grid-template-columns:1fr auto auto;align-items:center;gap:7px}.shutterHint{font-size:8px;color:#777267}.pullBtn{height:34px;padding:0 14px;border:1px solid #665535;background:#241d12;color:#e3c895;cursor:pointer}.pullBtn:hover{background:#302417}.pullBtn.primary{background:#5b3619;border-color:#9d6832;color:#ffe1a5;min-width:92px}.pullBtn:disabled{opacity:.45;cursor:not-allowed}
.controlDeck{display:grid;grid-template-rows:auto 1fr;min-height:0}.statusRail{padding:7px 8px;border-bottom:1px solid var(--line);display:grid;grid-template-columns:repeat(3,1fr);gap:5px}.statusBox{background:#11110e;border:1px solid #302e26;padding:5px 6px}.statusK{font-size:7px;color:#6f6b5e}.statusV{font-size:10px;color:#c8c0aa;margin-top:2px}
.resultPanel{min-height:0;display:grid;grid-template-rows:30px 1fr}.resultHeader{padding:0 8px;display:flex;align-items:center;justify-content:space-between;font-size:8px;color:#777267;border-bottom:1px solid #2e2c24}.resultList{padding:6px;overflow:auto;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));align-content:start;gap:5px;background:
  linear-gradient(90deg,transparent 0 7px,#28261f 7px 10px,transparent 10px calc(100% - 10px),#28261f calc(100% - 10px) calc(100% - 7px),transparent calc(100% - 7px));}
.resultEmpty{grid-column:1/-1;min-height:150px;display:grid;place-items:center;color:#555146;font-size:9px;text-align:center;line-height:1.7}
.resultCard{position:relative;min-height:64px;background:#0e0e0c;border:1px solid #343127;padding:8px 7px 7px 10px;overflow:hidden}.resultCard::before{content:"";position:absolute;left:3px;top:4px;bottom:4px;width:2px;background:repeating-linear-gradient(to bottom,#4c493e 0 4px,transparent 4px 8px)}
.resultGrade{font-size:7px;letter-spacing:.05em;margin-bottom:5px}.resultName{font-size:10px;line-height:1.3}.resultMeta{font-size:7px;color:#777267;margin-top:5px}.resultFlags{position:absolute;right:5px;top:5px;display:flex;gap:3px}.flag{font-size:6px;padding:2px 3px;border:1px solid #574c32;color:#e7b969;background:#1f1910}.flag.new{color:#ffe27c;border-color:#8b742d}.lensResult{border-color:#2d4850;background:#0d1416}.infra{color:var(--infra)}.ultra{color:var(--ultra)}.lumen{color:var(--lumen)}.lens{color:var(--lens)}
/* OTHER PAGES */
.pageGrid{height:100%;display:grid;grid-template-rows:auto 1fr;gap:8px;min-height:0}.toolbar{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:7px 8px}.toolbarGroup{display:flex;gap:5px;flex-wrap:wrap}.tinyBtn{height:28px;border:1px solid #38352b;background:#14130f;color:#918b78;padding:0 9px;cursor:pointer}.tinyBtn.active,.tinyBtn:hover{border-color:#776443;color:#e1bd7b;background:#211b12}.contentScroll{min-height:0;overflow:auto;padding:9px}
.collectionList{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px;align-content:start}.charCard{border:1px solid #343127;background:#11110e;padding:8px;min-height:72px;position:relative}.charCard.dimmed{opacity:.28;filter:grayscale(.7)}.charName{font-size:10px}.charGroup{font-size:7px;color:#6c685d;margin-top:4px}.lensChildren{margin-top:7px;border-top:1px solid #28261f;padding-top:5px}.lensChild{font-size:8px;color:var(--lens);padding:2px 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.groupHeader{grid-column:1/-1;font-size:9px;color:#b6aa8d;border-bottom:1px solid #3a372c;padding:8px 2px 4px;letter-spacing:.08em}
.lensGroups{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px;align-content:start}.lensGroup{border:1px solid #33434a;background:#0d1214}.lensGroupHead{padding:7px 8px;border-bottom:1px solid #293b42;display:flex;justify-content:space-between}.lensGroupName{font-size:10px}.lensGroupCount{font-size:8px;color:#718d96}.lensSlots{padding:6px;display:grid;gap:5px}.lensSlot{border:1px solid #2f4046;background:#10181b;padding:7px;font-size:8px;color:var(--lens);min-height:44px}.lensSlot.missing{opacity:.25}.slotParent{font-size:7px;color:#5e747b;margin-top:4px}
.exchangeColumns{display:grid;grid-template-columns:1fr 1fr;gap:8px}.exchangeSection{border:1px solid var(--line);background:#10100d}.exchangeHead{height:31px;padding:0 8px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line);font-size:9px;color:#b7ae99}.exchangeList{padding:6px;display:grid;gap:5px;max-height:calc(100vh - 145px);overflow:auto}.exchangeRow{border:1px solid #302e26;background:#13120f;padding:6px 7px;display:grid;grid-template-columns:1fr auto;gap:7px;align-items:center}.exchangeName{font-size:9px}.exchangeSub{font-size:7px;color:#6f6b60;margin-top:3px}.exchangeBtn{height:28px;border:1px solid #654f2e;background:#21190f;color:#e0b76f;padding:0 8px;cursor:pointer}.exchangeBtn:disabled{opacity:.35;cursor:not-allowed}
.logList{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:6px;align-content:start}.logCard{border:1px solid #343127;background:#11110e;padding:7px}.logMeta{font-size:7px;color:#777267;border-bottom:1px solid #29271f;padding-bottom:5px;margin-bottom:5px}.logLine{font-size:8px;padding:2px 0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.resetBtn{border-color:#5f3028!important;color:#d67a68!important}.note{font-size:8px;color:#747064;line-height:1.5}
.flash{position:fixed;inset:0;background:#fff;opacity:0;pointer-events:none;z-index:1000}.flash.fire{animation:flash .26s ease-out}@keyframes flash{0%{opacity:0}20%{opacity:.88}100%{opacity:0}}
@keyframes lensGlow{0%{box-shadow:0 0 0 rgba(143,201,216,0)}50%{box-shadow:0 0 18px rgba(143,201,216,.45)}100%{box-shadow:0 0 0 rgba(143,201,216,0)}}
@keyframes rareGlow{0%{box-shadow:0 0 0 rgba(214,155,67,0)}50%{box-shadow:0 0 18px rgba(214,155,67,.35)}100%{box-shadow:0 0 0 rgba(214,155,67,0)}}
.newLensEffect{animation:lensGlow .55s ease}.newRareEffect{animation:rareGlow .55s ease}
/* landscape compact */
@media (orientation:landscape) and (max-height:650px){
  .app{grid-template-rows:44px 1fr}.topbar{padding:0 9px}.brandMark{width:25px;height:25px}.brandTitle{font-size:11px}.brandSub{display:none}.meter{padding:3px 6px;min-width:76px}.meterLabel{font-size:7px}.meterValue{font-size:10px}
  .shell{grid-template-columns:66px 1fr}.nav{padding:5px 4px;gap:3px}.navBtn{min-height:45px;padding:5px 2px}.navIcon{font-size:15px;margin-bottom:4px}.navText{font-size:8px}
  .page{padding:6px}.gachaGrid{gap:5px;grid-template-columns:minmax(140px,22%) minmax(280px,1fr) minmax(210px,31%)}.panelHeader{height:28px}.bannerList{height:calc(100% - 28px);padding:5px;gap:4px}.bannerCard{padding:6px 6px 6px 12px;min-height:58px}.bannerName{font-size:9px}.bannerMini{font-size:7px;margin-top:4px}.hero{padding:10px;width:88%}.heroTitle{font-size:clamp(16px,2.7vw,26px);margin:6px 0}.heroDesc{font-size:8px}.pickupPlate{margin-top:8px;gap:4px}.pickupChip{padding:4px 6px;font-size:7px}.exposureBar{bottom:7px;font-size:7px}.shutterStrip{padding:4px 6px}.pullBtn{height:30px}.statusRail{padding:4px 5px}.statusV{font-size:8px}.resultList{padding:4px;gap:3px}.resultCard{min-height:52px;padding:6px 5px 5px 9px}.resultName{font-size:8px}.resultMeta{font-size:6px}
  .collectionList,.lensGroups{grid-template-columns:repeat(4,minmax(0,1fr))}.charCard{min-height:58px;padding:6px}.contentScroll{padding:6px}.toolbar{padding:4px 6px}.tinyBtn{height:25px;font-size:8px}.exchangeList{max-height:calc(100vh - 115px)}.logList{grid-template-columns:repeat(3,minmax(0,1fr))}
}
@media (max-width:760px) and (orientation:portrait){
  html,body{overflow:auto}.app{height:auto;min-height:100vh;grid-template-rows:52px auto}.shell{grid-template-columns:1fr;grid-template-rows:auto 1fr}.nav{position:sticky;top:52px;z-index:10;border-right:0;border-bottom:1px solid var(--line);flex-direction:row;overflow:auto}.navBtn{min-width:72px;min-height:48px}.main{height:calc(100vh - 110px)}.gachaGrid{grid-template-columns:1fr;grid-template-rows:auto minmax(280px,1fr) auto}.bannerRack{max-height:180px}.controlDeck{min-height:280px}.collectionList,.lensGroups,.exchangeColumns,.logList{grid-template-columns:1fr}
}
</style>
</head>
<body>
<div class="flash" id="flash"></div>
<div class="app">
  <header class="topbar">
    <div class="brand">
      <div class="brandMark">◉</div>
      <div>
        <div class="brandTitle">N.O.D. OPTICAL HEADHUNTING TERMINAL</div>
        <div class="brandSub">ANALOG RECRUITMENT / PERTURBATION LENS ARCHIVE</div>
      </div>
    </div>
    <div class="resources">
      <div class="meter"><div class="meterLabel">EXPOSURES</div><div class="meterValue" id="totalCountTop">0</div></div>
      <div class="meter"><div class="meterLabel">AFTERGLOW</div><div class="meterValue" id="glowCountTop">0</div></div>
    </div>
  </header>

  <div class="shell">
    <nav class="nav">
      <button class="navBtn active" data-page="gacha"><span class="navIcon">◉</span><span class="navText">헤드헌팅</span></button>
      <button class="navBtn" data-page="collection"><span class="navIcon">▣</span><span class="navText">보유 인원</span></button>
      <button class="navBtn" data-page="lenses"><span class="navIcon">◇</span><span class="navText">섭동 렌즈</span></button>
      <button class="navBtn" data-page="exchange"><span class="navIcon">⌁</span><span class="navText">잔광 보정</span></button>
      <button class="navBtn" data-page="history"><span class="navIcon">▤</span><span class="navText">가챠 기록</span></button>
    </nav>

    <main class="main">
      <!-- GACHA -->
      <section class="page active" id="page-gacha">
        <div class="gachaGrid">
          <div class="panel bannerRack">
            <div class="panelHeader"><span class="panelTitle">FILM MAGAZINE</span><span class="panelMeta">BANNERS</span></div>
            <div class="bannerList" id="bannerList"></div>
          </div>

          <div class="panel cameraDeck">
            <div class="viewfinder">
              <span class="corner c1"></span><span class="corner c2"></span><span class="corner c3"></span><span class="corner c4"></span><span class="focusCross"></span>
              <div class="hero">
                <div class="heroOverline" id="bannerType">FOCUSED HEADHUNTING</div>
                <div class="heroTitle" id="bannerTitle">-</div>
                <div class="heroDesc" id="bannerSubtitle">-</div>
                <div class="pickupPlate" id="pickupInfo"></div>
              </div>
              <div class="exposureBar"><span>ISO <strong>446</strong></span><span>APERTURE <strong>ƒ/1.4</strong></span><span>MODE <strong>AUTO</strong></span><span>LUMEN <strong>3%</strong></span></div>
            </div>
            <div class="shutterStrip">
              <div class="shutterHint">LUMEN 3% · ULTRA 20% · INFRA 77% / 10회 시 ULTRA 이상 1개 보장</div>
              <button class="pullBtn" id="btn1">1 EXPOSURE</button>
              <button class="pullBtn primary" id="btn10">10 EXPOSURES</button>
            </div>
          </div>

          <div class="panel controlDeck">
            <div class="statusRail">
              <div class="statusBox"><div class="statusK">CURRENT</div><div class="statusV" id="currentBannerShort">-</div></div>
              <div class="statusBox"><div class="statusK">OWNED</div><div class="statusV" id="ownedCount">0</div></div>
              <div class="statusBox"><div class="statusK">LENSES</div><div class="statusV" id="lensCount">0/27</div></div>
            </div>
            <div class="resultPanel">
              <div class="resultHeader"><span>DEVELOPED NEGATIVES</span><span id="resultCount">NO EXPOSURE</span></div>
              <div class="resultList" id="result"><div class="resultEmpty">셔터를 눌러<br>새로운 상을 현상하십시오.</div></div>
            </div>
          </div>
        </div>
      </section>

      <!-- COLLECTION -->
      <section class="page" id="page-collection">
        <div class="pageGrid">
          <div class="panel toolbar">
            <div class="toolbarGroup">
              <button class="tinyBtn active" data-sort="grade">등급순</button>
              <button class="tinyBtn" data-sort="name">가나다순</button>
              <button class="tinyBtn" data-sort="group">소속순</button>
              <button class="tinyBtn" data-sort="all">전체보기</button>
            </div>
            <div class="note">CONTACT SHEET / INFRA 9인은 기본 지급 · 보유 렌즈는 하위 프레임으로 표시</div>
          </div>
          <div class="panel contentScroll"><div class="collectionList" id="collectionArea"></div></div>
        </div>
      </section>

      <!-- LENSES -->
      <section class="page" id="page-lenses">
        <div class="pageGrid">
          <div class="panel toolbar">
            <div><span class="panelTitle">PERTURBATION LENS ARCHIVE</span></div>
            <div class="note" id="lensProgress">0 / 27</div>
          </div>
          <div class="panel contentScroll"><div class="lensGroups" id="lensCollectionArea"></div></div>
        </div>
      </section>

      <!-- EXCHANGE -->
      <section class="page" id="page-exchange">
        <div class="pageGrid">
          <div class="panel toolbar">
            <div><span class="panelTitle">DARKROOM AFTERGLOW COMPENSATION</span></div>
            <div class="note">ULTRA 50 · LUMEN 200 · 섭동 렌즈 200</div>
          </div>
          <div class="exchangeColumns">
            <div class="exchangeSection"><div class="exchangeHead"><span>CHARACTER NEGATIVES</span><span id="exchangeCharCount">0</span></div><div class="exchangeList" id="exchangeCharacters"></div></div>
            <div class="exchangeSection"><div class="exchangeHead"><span>PERTURBATION LENSES</span><span id="exchangeLensCount">0</span></div><div class="exchangeList" id="exchangeLenses"></div></div>
          </div>
        </div>
      </section>

      <!-- HISTORY -->
      <section class="page" id="page-history">
        <div class="pageGrid">
          <div class="panel toolbar">
            <div><span class="panelTitle">EXPOSURE LOG / LAST 200</span></div>
            <div class="toolbarGroup"><button class="tinyBtn resetBtn">기록·보유 초기화</button></div>
          </div>
          <div class="panel contentScroll"><div class="logList" id="logList"></div></div>
        </div>
      </section>
    </main>
