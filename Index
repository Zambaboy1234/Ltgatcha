const BANNERS={
 belleEpoque:{id:"belleEpoque",type:"집중 헤드헌팅",title:"쌓아올리는 등불의 벨 에포크",short:"BELLE ÉPOQUE",subtitle:"등불의 시작과 함께한 인원들을 대상으로 한 집중 헤드헌팅.",pickups:[{type:"character",key:"발렌티나"},{type:"character",key:"크리스틴"}],pickupRate:.5},
 halLens:{id:"halLens",type:"섭동 집중 헤드헌팅",title:"사슬 너머의 세 가지 가능성",short:"HAL / 3 LENSES",subtitle:"할에게서 갈라져 나온 세 개의 섭동 렌즈가 집중 등장합니다.",pickups:[{type:"lens",key:"lens_hal_1"},{type:"lens",key:"lens_hal_2"},{type:"lens",key:"lens_hal_3"}],pickupRate:.5},
 standard:{id:"standard",type:"통상 헤드헌팅",title:"통상 헤드헌팅",short:"STANDARD",subtitle:"특정 인원 또는 섭동 렌즈에 대한 확률 보정이 적용되지 않습니다.",pickups:[],pickupRate:0}
};

const STORE=(()=>{
 const memory={};
 try{
  const testKey="__nod_storage_test__";
  window.localStorage.setItem(testKey,"1");
  window.localStorage.removeItem(testKey);
  return window.localStorage;
 }catch(e){
  console.warn("Persistent storage unavailable; using session memory.",e);
  return {
   getItem:key=>Object.prototype.hasOwnProperty.call(memory,key)?memory[key]:null,
   setItem:(key,value)=>{memory[key]=String(value)},
   removeItem:key=>{delete memory[key]}
  };
 }
})();

function loadArray(key){try{const v=JSON.parse(STORE.getItem(key));return Array.isArray(v)?v:[]}catch(e){return[]}}
let totalCount=parseInt(STORE.getItem("totalCount"))||0;
let collection=[...new Set([...INITIAL_CHARACTER_NAMES,...loadArray("collection")])];
let lensCollection=loadArray("lensCollection");
let glow=parseInt(STORE.getItem("glow"))||0;
let history=loadArray("history");
let currentBannerId=STORE.getItem("currentBannerId")||"belleEpoque";
if(!BANNERS[currentBannerId])currentBannerId="belleEpoque";
let sortMode="grade";
let isRolling=false;

function sleep(ms){return new Promise(r=>setTimeout(r,ms))}
function getCharacter(name){return DB.find(c=>c.name===name)}
function getLens(id){return LENS_DB.find(l=>l.id===id)}
function getGradeText(r){return r===3?"LUMEN ★★★":r===2?"ULTRA ★★":"INFRA ★"}
function getClass(r){return r===3?"lumen":r===2?"ultra":"infra"}
function rollRarity(){const r=Math.random();if(r<.03)return 3;if(r<.23)return 2;return 1}
function saveData(){collection=[...new Set([...INITIAL_CHARACTER_NAMES,...collection])];STORE.setItem("totalCount",totalCount);STORE.setItem("collection",JSON.stringify(collection));STORE.setItem("lensCollection",JSON.stringify(lensCollection));STORE.setItem("glow",glow)}

function showPage(page){document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id===`page-${page}`));document.querySelectorAll('.navBtn').forEach(b=>b.classList.toggle('active',b.dataset.page===page));if(page==='collection')renderCollection();if(page==='lenses')renderLensCollection();if(page==='exchange')renderExchange();if(page==='history')renderLog()}

function resolvePickup(p){if(p.type==='character'){const c=getCharacter(p.key);return c?{type:'character',key:c.name,rarity:c.rarity,item:c}:null}if(p.type==='lens'){const l=getLens(p.key);return l?{type:'lens',key:l.id,rarity:3,item:l}:null}return null}
function createCharacterResult(c,isPickup=false){return{type:'character',name:c.name,rarity:c.rarity,group:c.group,isPickup}}
function createLensResult(l,isPickup=false){return{type:'lens',id:l.id,name:l.name,parent:l.parent,rarity:3,isPickup}}

function renderBannerList(){const area=document.getElementById('bannerList');area.innerHTML=Object.values(BANNERS).map(b=>`<button type="button" class="bannerCard ${b.id===currentBannerId?'active':''}" data-banner-id="${b.id}"><div class="bannerType">${b.type}</div><div class="bannerName">${b.title}</div><div class="bannerMini">${b.short}</div></button>`).join('')}
function selectBanner(id){if(isRolling||!BANNERS[id])return;currentBannerId=id;STORE.setItem('currentBannerId',id);renderBannerList();updateBannerUI();document.getElementById('result').innerHTML='<div class="resultEmpty">필름 매거진이 교체되었습니다.<br>새 노출을 시작하십시오.</div>';document.getElementById('resultCount').textContent='MAGAZINE CHANGED'}
function updateBannerUI(){const b=BANNERS[currentBannerId];document.getElementById('bannerType').textContent=b.type.toUpperCase();document.getElementById('bannerTitle').textContent=b.title;document.getElementById('bannerSubtitle').textContent=b.subtitle;document.getElementById('currentBannerShort').textContent=b.short;const area=document.getElementById('pickupInfo');if(!b.pickups.length){area.innerHTML='<span class="pickupChip">NO RATE-UP / STANDARD POOL</span>';return}area.innerHTML=b.pickups.map(p=>{const r=resolvePickup(p);if(!r)return'';if(r.type==='lens')return`<span class="pickupChip lens">◇ ${r.item.name}</span>`;return`<span class="pickupChip ${getClass(r.item.rarity)}">${getGradeText(r.item.rarity)} · ${r.item.name}</span>`}).join('')+`<span class="pickupChip">RATE-UP ${Math.round(b.pickupRate*100)}%</span>`}

function rollResultByRarity(rarity){const b=BANNERS[currentBannerId];const pickups=b.pickups.map(resolvePickup).filter(p=>p&&p.rarity===rarity);if(pickups.length&&Math.random()<b.pickupRate){const p=pickups[Math.floor(Math.random()*pickups.length)];return p.type==='character'?createCharacterResult(p.item,true):createLensResult(p.item,true)}const excludedCharacters=new Set(pickups.filter(p=>p.type==='character').map(p=>p.key));const excludedLenses=new Set(pickups.filter(p=>p.type==='lens').map(p=>p.key));let charPool=DB.filter(c=>c.rarity===rarity&&!excludedCharacters.has(c.name)).map(c=>createCharacterResult(c,false));if(rarity===3){let lensPool=LENS_DB.filter(l=>!excludedLenses.has(l.id)).map(l=>createLensResult(l,false));let pool=[...charPool,...lensPool];if(!pool.length)pool=[...DB.filter(c=>c.rarity===3).map(c=>createCharacterResult(c,false)),...LENS_DB.map(l=>createLensResult(l,false))];return pool[Math.floor(Math.random()*pool.length)]}if(!charPool.length)charPool=DB.filter(c=>c.rarity===rarity).map(c=>createCharacterResult(c,false));return charPool[Math.floor(Math.random()*charPool.length)]}

async function pull(times){if(isRolling)return;isRolling=true;document.getElementById('btn1').disabled=true;document.getElementById('btn10').disabled=true;const flash=document.getElementById('flash');flash.classList.remove('fire');void flash.offsetWidth;flash.classList.add('fire');let results=[];for(let i=0;i<times;i++)results.push(rollResultByRarity(rollRarity()));if(times===10&&!results.some(r=>r.rarity>=2))results[9]=rollResultByRarity(2);const area=document.getElementById('result');area.innerHTML='';document.getElementById('resultCount').textContent=`${times} FRAME${times>1?'S':''}`;for(const r of results){totalCount++;glow++;let isNew=false;if(r.type==='lens'){isNew=!lensCollection.includes(r.id);if(isNew)lensCollection.push(r.id)}else{isNew=!collection.includes(r.name);if(isNew)collection.push(r.name)}const card=document.createElement('div');if(r.type==='lens'){card.className='resultCard lensResult';card.innerHTML=`<div class="resultGrade lens">PERTURBATION LENS</div><div class="resultName lens">◇ ${r.name}</div><div class="resultMeta">PARENT / ${r.parent}</div><div class="resultFlags">${r.isPickup?'<span class="flag">PICK UP</span>':''}${isNew?'<span class="flag new">NEW</span>':''}</div>`}else{card.className='resultCard';card.innerHTML=`<div class="resultGrade ${getClass(r.rarity)}">${getGradeText(r.rarity)}</div><div class="resultName ${getClass(r.rarity)}">${r.name}</div><div class="resultMeta">${r.group}</div><div class="resultFlags">${r.isPickup?'<span class="flag">PICK UP</span>':''}${isNew?'<span class="flag new">NEW</span>':''}</div>`}area.appendChild(card);await sleep(45);if(isNew){card.classList.add(r.type==='lens'?'newLensEffect':'newRareEffect');await sleep(140)}}saveHistory(times,results);saveData();updateCounters();renderCollection();renderLensCollection();isRolling=false;document.getElementById('btn1').disabled=false;document.getElementById('btn10').disabled=false}

function saveHistory(times,results){const now=new Date();const ds=now.getFullYear()+'-'+String(now.getMonth()+1).padStart(2,'0')+'-'+String(now.getDate()).padStart(2,'0')+' '+String(now.getHours()).padStart(2,'0')+':'+String(now.getMinutes()).padStart(2,'0');history.unshift({date:ds,count:times,bannerId:currentBannerId,bannerTitle:BANNERS[currentBannerId].title,results});if(history.length>200)history=history.slice(0,200);STORE.setItem('history',JSON.stringify(history))}

function updateCounters(){document.getElementById('totalCountTop').textContent=totalCount;document.getElementById('glowCountTop').textContent=glow;document.getElementById('ownedCount').textContent=`${collection.length}/${DB.length}`;document.getElementById('lensCount').textContent=`${lensCollection.length}/${LENS_DB.length}`;document.getElementById('lensProgress').textContent=`${lensCollection.length} / ${LENS_DB.length}`}

function setSort(mode){sortMode=mode;document.querySelectorAll('[data-sort]').forEach(b=>b.classList.toggle('active',b.dataset.sort===mode));renderCollection()}
function renderCharacterCard(c,owned){const lenses=LENS_DB.filter(l=>l.parent===c.name&&lensCollection.includes(l.id));return`<div class="charCard ${owned?'':'dimmed'}"><div class="resultGrade ${getClass(c.rarity)}">${getGradeText(c.rarity)}</div><div class="charName ${getClass(c.rarity)}">${c.name}</div><div class="charGroup">${c.group}</div>${lenses.length?`<div class="lensChildren">${lenses.map(l=>`<div class="lensChild">◇ ${l.name}</div>`).join('')}</div>`:''}</div>`}
function renderCollection(){const area=document.getElementById('collectionArea');const ownedSet=new Set(collection);let list=sortMode==='all'?[...DB]:DB.filter(c=>ownedSet.has(c.name));if(sortMode==='name')list.sort((a,b)=>a.name.localeCompare(b.name,'ko'));else if(sortMode==='group')list.sort((a,b)=>a.group.localeCompare(b.group,'ko')||a.name.localeCompare(b.name,'ko'));else list.sort((a,b)=>b.rarity-a.rarity||a.name.localeCompare(b.name,'ko'));let html='';let group='';for(const c of list){if(sortMode==='group'&&c.group!==group){group=c.group;html+=`<div class="groupHeader">${group}</div>`}html+=renderCharacterCard(c,ownedSet.has(c.name))}area.innerHTML=html||'<div class="note">보유 인원 없음</div>'}

function renderLensCollection(){const area=document.getElementById('lensCollectionArea');let html='';for(const parent of INITIAL_CHARACTER_NAMES){const lenses=LENS_DB.filter(l=>l.parent===parent);const owned=lenses.filter(l=>lensCollection.includes(l.id)).length;html+=`<div class="lensGroup"><div class="lensGroupHead"><span class="lensGroupName">${parent}</span><span class="lensGroupCount">${owned}/3</span></div><div class="lensSlots">${lenses.map(l=>{const has=lensCollection.includes(l.id);return`<div class="lensSlot ${has?'':'missing'}">${has?'◇ '+l.name:'◇ UNDEVELOPED NEGATIVE'}<div class="slotParent">${parent} / FRAME ${l.id.split('_').pop()}</div></div>`}).join('')}</div></div>`}area.innerHTML=html;document.getElementById('lensProgress').textContent=`${lensCollection.length} / ${LENS_DB.length}`}

function renderExchange(){
 const chars=DB.filter(c=>!collection.includes(c.name)&&(c.rarity===2||c.rarity===3));
 const lenses=LENS_DB.filter(l=>!lensCollection.includes(l.id));
 document.getElementById('exchangeCharCount').textContent=`${chars.length} AVAILABLE`;
 document.getElementById('exchangeLensCount').textContent=`${lenses.length} AVAILABLE`;
 document.getElementById('exchangeCharacters').innerHTML=chars.length?chars.map(c=>{
  const cost=c.rarity===3?200:50;
  return `<div class="exchangeRow"><div><div class="exchangeName ${getClass(c.rarity)}">${getGradeText(c.rarity)} · ${c.name}</div><div class="exchangeSub">${c.group}</div></div><button type="button" class="exchangeBtn" data-character="${c.name}" data-cost="${cost}" ${glow<cost?'disabled':''}>${cost}</button></div>`
 }).join(''):'<div class="note">모든 교환 대상 캐릭터를 보유 중입니다.</div>';
 document.getElementById('exchangeLenses').innerHTML=lenses.length?lenses.map(l=>`<div class="exchangeRow"><div><div class="exchangeName lens">◇ ${l.name}</div><div class="exchangeSub">${l.parent}</div></div><button type="button" class="exchangeBtn" data-lens="${l.id}" data-cost="200" ${glow<200?'disabled':''}>200</button></div>`).join(''):'<div class="note">모든 섭동 렌즈를 보유 중입니다.</div>';
}

function exchangeCharacter(name,cost){if(glow<cost)return;if(!confirm(`${name}을(를) 잔광 ${cost}으로 현상하시겠습니까?`))return;glow-=cost;if(!collection.includes(name))collection.push(name);saveData();updateCounters();renderExchange();renderCollection()}
function exchangeLens(id,cost){const l=getLens(id);if(!l||glow<cost)return;if(!confirm(`${l.name}을(를) 잔광 ${cost}으로 현상하시겠습니까?`))return;glow-=cost;if(!lensCollection.includes(id))lensCollection.push(id);saveData();updateCounters();renderExchange();renderLensCollection();renderCollection()}

function renderLog(){const area=document.getElementById('logList');if(!history.length){area.innerHTML='<div class="note">노출 기록이 없습니다.</div>';return}area.innerHTML=history.map(rec=>`<div class="logCard"><div class="logMeta">${rec.date} / ${rec.count}회 / ${rec.bannerTitle||'기존 헤드헌팅'}</div>${rec.results.map(r=>r.type==='lens'?`<div class="logLine lens">◇ ${r.name}${r.isPickup?' · PICK UP':''}</div>`:`<div class="logLine ${getClass(r.rarity)}">${getGradeText(r.rarity)} · ${r.name}${r.isPickup?' · PICK UP':''}</div>`).join('')}</div>`).join('')}

function resetData(){if(!confirm('모든 가챠 기록, 추가 캐릭터, 섭동 렌즈와 잔광을 초기화하시겠습니까?\nINFRA 기본 대원 9명은 유지됩니다.'))return;totalCount=0;glow=0;collection=[...INITIAL_CHARACTER_NAMES];lensCollection=[];history=[];STORE.setItem('totalCount','0');STORE.setItem('glow','0');STORE.setItem('collection',JSON.stringify(collection));STORE.setItem('lensCollection','[]');STORE.setItem('history','[]');document.getElementById('result').innerHTML='<div class="resultEmpty">필름이 초기화되었습니다.<br>새 노출을 시작하십시오.</div>';document.getElementById('resultCount').textContent='RESET';updateCounters();renderCollection();renderLensCollection();renderExchange();renderLog()}

function bindControls(){
 document.querySelectorAll('.navBtn').forEach(btn=>btn.addEventListener('click',()=>showPage(btn.dataset.page)));
 document.getElementById('btn1').addEventListener('click',()=>pull(1));
 document.getElementById('btn10').addEventListener('click',()=>pull(10));
 document.querySelectorAll('[data-sort]').forEach(btn=>btn.addEventListener('click',()=>setSort(btn.dataset.sort)));
 const resetBtn=document.querySelector('.resetBtn');
 if(resetBtn)resetBtn.addEventListener('click',resetData);
 document.getElementById('bannerList').addEventListener('click',event=>{
  const card=event.target.closest('[data-banner-id]');
  if(card)selectBanner(card.dataset.bannerId);
 });
 document.getElementById('exchangeCharacters').addEventListener('click',event=>{
  const btn=event.target.closest('button[data-character]');
  if(btn&&!btn.disabled)exchangeCharacter(btn.dataset.character,Number(btn.dataset.cost));
 });
 document.getElementById('exchangeLenses').addEventListener('click',event=>{
  const btn=event.target.closest('button[data-lens]');
  if(btn&&!btn.disabled)exchangeLens(btn.dataset.lens,Number(btn.dataset.cost));
 });
}

bindControls();
renderBannerList();updateBannerUI();updateCounters();renderCollection();renderLensCollection();saveData();
</script>
</body>
</html>
